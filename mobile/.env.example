# Backend base URL, e.g. http://192.168.x.x:3000 (LAN IP for device testing)
EXPO_PUBLIC_SERVER_URL=

# Google OAuth WEB client ID (Google Cloud Console → Credentials → OAuth 2.0).
# The native SDK mints an ID token with this audience; the server verifies it.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Google OAuth ANDROID client ID (package com.irfan140.NutriSnap(.dev/.preview)
# + SHA-1 fingerprints registered in Google Cloud). Resolve on Android itself.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Optional: Google OAuth iOS client URL scheme (the reverse client ID, starts
# with "com.googleusercontent.apps."). Build-time only: set it before running
# `npx expo prebuild` / EAS build to apply the Google Sign-In config plugin.
# iOS registration is otherwise a manual follow-up.
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
