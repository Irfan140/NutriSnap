PORT=3000
NODE_ENV=development
LOG_LEVEL=info
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.3
AI_MODEL_PROVIDER=openai
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=
DATABASE_URL=postgresql://myuser:mypassword@localhost:5432/nutrisnap
REDIS_URL=redis://localhost:6379
# --- Production (docker-compose.prod.yml on VPS) ---
# Postgres/Redis run in the same compose stack — point at the service names:
# DATABASE_URL=postgresql://myuser:mypassword@postgres:5432/nutrisnap
# REDIS_URL=redis://redis:6379
# Optional: set REDIS_PASSWORD to password-protect Redis. When set, REDIS_URL
# must include it: REDIS_URL=redis://:mypassword@redis:6379
# REDIS_PASSWORD=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PRESIGN_PUT_TTL_SEC=300
R2_PRESIGN_GET_TTL_SEC=900
