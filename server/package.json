{
  "name": "server",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development bun --watch src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "bunx --bun prisma generate",
    "prisma:push": "bunx --bun prisma db push",
    "prisma:migrate": "bunx --bun prisma migrate dev",
    "prisma:studio": "bunx --bun prisma studio",
    "prisma:reset": "bunx --bun prisma migrate reset"
  },
  "dependencies": {
    "@clerk/express": "^2.1.56",
    "@langchain/core": "^1.2.10",
    "@langchain/openai": "^1.5.12",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.2",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.1.3",
    "prisma": "7.10.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
