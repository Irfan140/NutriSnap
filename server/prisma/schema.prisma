
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Mirror of the Clerk user. Clerk remains the source of truth for identity;
// this table exists so meal analyses and jobs can reference a local owner.
// Kept in sync via the Clerk Svix webhook (user.created/updated/deleted)
// with lazy ensure on first authenticated API call as a backstop.
model User {
  id        String   @id @default(uuid())
  clerkId   String   @unique
  email     String?
  name      String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meals MealAnalysis[]
}

enum MealAnalysisStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
}

// One row per requested meal analysis. Acts as the durable job record that
// the mobile client polls (GET /api/aifood/:id) and as the history entry.
model MealAnalysis {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  r2Key       String
  status      MealAnalysisStatus @default(QUEUED)
  nutrition   Json?
  healthScore Int?
  healthAdvice String[] @default([])
  alternativeSuggestions String[] @default([])
  summary     String?
  // Pre-formatted wire message (```json block + Markdown) so the mobile
  // render path stays identical to the old synchronous endpoint.
  message     String?
  error       String?
  model       String?
  promptTokens Int?
  completionTokens Int?
  durationMs  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  completedAt DateTime?

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
}
